<launch>

  <node name="recognizer" pkg="pocketsphinx" type="recognizer.py" output="screen">
    <param name="hmm" value="$(find pocketsphinx)/demo/zh_cn_cd_cont_5000"/>
    <param name="lm" value="$(find pocketsphinx)/demo/zh_cn_test.lm"/>
    <param name="dict" value="$(find pocketsphinx)/demo/zh_cn_test.dic"/>
    <param name="source" value="alsasrc"/>
  </node>

</launch>
